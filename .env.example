APIFY_TOKEN=
# Preferred LLM path — OpenRouter (Anthropic Messages API compatible).
# Use baseURL https://openrouter.ai/api (NOT …/api/v1; the SDK appends /v1/messages).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_BASE_URL=https://openrouter.ai/api
# Optional direct Anthropic fallback when OPENROUTER_API_KEY is unset.
ANTHROPIC_API_KEY=
APP_ACCESS_TOKEN=
APP_PUBLIC_URL=
DATABASE_URL="file:./dev.db"
# Cohesivity Postgres (HTTP edge). When set (and not in test mode), the app uses
# Cohesivity instead of Prisma/SQLite. Get the key from .cohesivity (coh_application_key).
COH_APPLICATION_KEY=
# Optional override: cohesivity | sqlite
DATABASE_PROVIDER=
# 0 or "unlimited" = no dollar ceiling (recommended). A positive number re-enables a soft cap.
MAX_QUERY_COST_USD=0
MAX_ITEMS_CAP=100
SCRAPER_TEST_MODE=0
PLANNER_EVAL_LIVE=0
